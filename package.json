{
    "name": "fx-natives-mcp",
    "version": "1.0.0",
    "description": "MCP server for searching and retrieving CFX/FiveM/RedM native method documentation",
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "bin": {
        "fx-natives-mcp": "./dist/index.js"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "inspect": "mcp-inspector bun run .",
        "dev": "bun run src/index.ts",
        "build": "bun run build.ts",
        "prepublishOnly": "bun run build",
        "release": "bun run scripts/release.ts",
        "publish:build": "bun run build && npm publish --access public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "rdr2",
        "gta",
        "lua",
        "typescript"
    ],
    "author": "Aleksander Evensen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/AleksanderEvensen/fx-natives-mcp"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/inspector": "^0.17.5",
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.24.3",
        "destr": "^2.0.5",
        "fuse.js": "^7.1.0",
        "ofetch": "^1.5.1",
        "zod": "^4.2.0"
    }
}
